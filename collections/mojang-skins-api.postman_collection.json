          "name": "Change Skin",
          "request": {
            "name": "Change Skin",
            "description": {
              "content": "Set the player's active skin. Accepts either a URL pointing to the skin image (JSON body) or a multipart upload of the image file.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "minecraft",
                "profile",
                "skins"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "variant",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required)  (This can only be one of classic,slim)"
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) PNG skin image upload."
                }
              ]
            }
          },
