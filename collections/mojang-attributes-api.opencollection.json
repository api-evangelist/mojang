{
  "opencollection": "1.0.0",
  "info": {
    "name": "Minecraft Services Attributes API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Attributes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Player Attributes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.minecraftservices.com/player/attributes",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the player's account attributes: privileges, profanity filter preferences, friends preferences, chat settings, and ban / suspension status."
        },
        {
          "info": {
            "name": "Update Player Attributes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.minecraftservices.com/player/attributes",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update the player's profanity filter and friends preferences."
        }
      ]
    }
  ],
  "bundled": true
}