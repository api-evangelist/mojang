              "body": "{\n  \"keyPair\": {\n    \"privateKey\": \"-----BEGIN RSA PRIVATE KEY-----...\",\n    \"publicKey\": \"-----BEGIN RSA PUBLIC KEY-----...\"\n  },\n  \"publicKeySignature\": \"a1b2c3...\",\n  \"publicKeySignatureV2\": \"a1b2c3...\",\n  \"expiresAt\": \"2026-06-01T00:00:00Z\",\n  \"refreshedAfter\": \"2026-05-31T12:00:00Z\"\n}",
